{
  "name": "seraphine-portfolio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run check:offline && npm test --workspaces",
    "prisma:validate": "npm run prisma:validate -w backend",
    "prisma:generate": "npm run prisma:generate -w backend",
    "check:offline": "node --test scripts/*.test.mjs",
    "test:browser": "node --import tsx scripts/phase08-browser.mjs",
    "verify:database": "node scripts/phase08-database.mjs",
    "measure:performance": "node scripts/phase08-performance.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "lighthouse": "13.5.0"
  }
}
