// PHASE 3 FOUNDATION — This schema is PROPOSED, not migrated to a live MySQL DB.
// MySQL via Prisma 7; use a driver adapter when introducing PrismaClient in Phase 5.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique @db.VarChar(191)
  passwordHash String     @db.VarChar(255)
  displayName  String     @db.VarChar(150)
  role         Role       @default(ADMIN)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Profile {
  id                String   @id @default(cuid())
  fullName          String   @db.VarChar(150)
  professionalTitle String   @db.VarChar(200)
  location          String?  @db.VarChar(150)
  motto             String?  @db.VarChar(255)
  summary           String?  @db.Text
  email             String?  @db.VarChar(191)
  phone             String?  @db.VarChar(40)
  showPublicContact Boolean  @default(false)
  status            PublicationStatus @default(DRAFT)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Experience {
  id               String   @id @default(cuid())
  jobTitle         String   @db.VarChar(200)
  organization     String   @db.VarChar(200)
  startYear        Int
  endYear          Int?
  responsibilities String?  @db.Text
  isVerified       Boolean  @default(false)
  status           PublicationStatus @default(DRAFT)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([status, sortOrder])
}

model Education {
  id            String   @id @default(cuid())
  qualification String   @db.VarChar(200)
  institution   String   @db.VarChar(200)
  yearCompleted Int?
  notes         String?  @db.Text
  isVerified    Boolean  @default(false)
  status        PublicationStatus @default(DRAFT)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([status, sortOrder])
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(200)
  category  String?  @db.VarChar(100)
  sortOrder Int      @default(0)
  status    PublicationStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(191)
  title       String   @db.VarChar(220)
  summary     String?  @db.Text
  body        String?  @db.LongText
  role        String?  @db.VarChar(160)
  result      String?  @db.Text
  year        Int?
  status      PublicationStatus @default(DRAFT)
  media       MediaAsset[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, createdAt])
}

model Certificate {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(220)
  issuer      String?  @db.VarChar(200)
  year        Int?
  isVerified  Boolean  @default(false)
  status      PublicationStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MediaAsset {
  id         String   @id @default(cuid())
  fileName   String   @db.VarChar(255)
  storageKey String   @unique @db.VarChar(255)
  mimeType   String   @db.VarChar(100)
  bytes      Int
  altText    String?  @db.VarChar(255)
  approved   Boolean  @default(false)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  @@index([projectId])
}

model ContactMessage {
  id         String   @id @default(cuid())
  senderName String   @db.VarChar(150)
  senderEmail String  @db.VarChar(191)
  subject    String?  @db.VarChar(200)
  content    String   @db.Text
  status     MessageStatus @default(NEW)
  createdAt  DateTime @default(now())
  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(120)
  entity    String?  @db.VarChar(120)
  entityId  String?  @db.VarChar(191)
  details   Json?
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
}
