# Copy to backend/.env. Do not commit backend/.env or put real secrets in ZIP files.
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Auth requires 64 random bytes encoded as 128 hex characters. No default signing key.
# Run npm run auth:key -w backend locally; it appends only when absent and prints no key.
JWT_SECRET=
# XAMPP normal-mode MariaDB on this workstation; start MySQL in XAMPP Control Panel.
# These new schemas replace the damaged historical names. See docs/XAMPP_SETUP.md.
# Placeholders only: never copy this example over an existing backend/.env.
# Percent-encode reserved characters in usernames/passwords.
# Runtime account: SELECT, INSERT, UPDATE, DELETE on this development schema only.
DATABASE_URL=mysql://seraphine_x3306_dev:CHANGE_ME@127.0.0.1:3306/seraphine_portfolio_dev_x3306_20261116
# Migration account: new development + dedicated shadow schemas only; no global grants.
MIGRATION_DATABASE_URL=mysql://seraphine_x3306_migrate:CHANGE_ME@127.0.0.1:3306/seraphine_portfolio_dev_x3306_20261116
SHADOW_DATABASE_URL=mysql://seraphine_x3306_migrate:CHANGE_ME@127.0.0.1:3306/seraphine_portfolio_shadow_x3306_20261116
# Integration tools require the exact approved local test schema/account/instance.
TEST_DATABASE_URL=mysql://seraphine_x3306_test:CHANGE_ME@127.0.0.1:3306/seraphine_portfolio_test_x3306_20261116
