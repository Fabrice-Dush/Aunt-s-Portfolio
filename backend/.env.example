# Copy to backend/.env. Do not commit backend/.env or put real secrets in ZIP files.
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Auth requires 64 random bytes encoded as 128 hex characters. No default signing key.
# Run npm run auth:key -w backend locally; it appends only when absent and prints no key.
JWT_SECRET=
# Dedicated local normal-mode MariaDB on this recovered workstation (see docs/XAMPP_SETUP.md).
# Port 3306 is the damaged historical shared instance; do not switch this project to it.
# These are placeholders, not production credentials. Preserve an existing backend/.env.
# Percent-encode reserved characters in usernames/passwords.
# Runtime account: SELECT, INSERT, UPDATE, DELETE on development database only.
DATABASE_URL=mysql://seraphine_dev:CHANGE_ME@127.0.0.1:13312/seraphine_portfolio_dev
# Migration account: development + dedicated shadow database only; never global grants.
MIGRATION_DATABASE_URL=mysql://seraphine_migrate:CHANGE_ME@127.0.0.1:13312/seraphine_portfolio_dev
SHADOW_DATABASE_URL=mysql://seraphine_migrate:CHANGE_ME@127.0.0.1:13312/seraphine_portfolio_shadow
# Integration tests refuse any other database name or nonlocal host.
TEST_DATABASE_URL=mysql://seraphine_test:CHANGE_ME@127.0.0.1:13312/seraphine_portfolio_test
